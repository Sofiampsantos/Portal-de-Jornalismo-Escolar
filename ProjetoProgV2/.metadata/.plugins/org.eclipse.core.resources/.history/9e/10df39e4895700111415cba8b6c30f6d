@charset "UTF-8";
@import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;600;700&display=swap');
 
 
/*ESTStyle GERAL*/
 
body {
    margin: 0;
    padding: 0;
    font-family: "Times New Roman", Times, serif;
    background-image: url("../img/jornmulheres.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
 
 
 
/*CONTAINER PRINCIPAL*/
 
.container {
    max-width: 1100px;
    margin: 40px auto;
    background-color: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 20px rgba(0,0,0,0.2);
    animation: aparecer 0.8s ease-in-out;
}
 
#container {
    width: 100%;
    margin: 0 auto;
}
 
 
/*CABEÇALHO*/
 
#topo {
    background-color: #b30000;
    color: #ffffff;
    padding: 20px;
    text-align: center;
}
 
#topo h1 {
    margin: 0;
}
 
#topo p {
    margin-top: 5px;
}
 
 
/*NAVEGAÇÃO*/
 
nav {
    display: flex;
    justify-content: space-around;
    background-color: #8B0000;
    padding: 15px 0;
}
 
nav a {
    color: white;
    text-decoration: none;
    padding: 10px;
}
 
/* Links com linha animada */
.menu a {
    position: relative;
}
 
.menu a::after {
    content: "";
    position: absolute;
    width: 0%;
    height: 2px;
    bottom: -5px;
    left: 0;
    background-color: #ffffff;
    transition: width 0.3s ease;
}
 
.menu a:hover::after {
    width: 100%;
}
 
nav ul li {
    display: inline;
}
 
 
/*CONTEÚDO*/
 
#conteudo {
    padding: 30px;
}
 
section {
    animation: aparecer 2s ease-in;
}
 
 
/*TÍTULOS*/
 
h2 {
    color: #b30000;
    border-bottom: 2px solid #4a2c1a;
    padding-bottom: 5px;
    font-family: 'League Spartan', Arial, sans-serif;
}
 
 
/*TEXTO*/
 
p {
    line-height: 1.6;
}
 
 
/*LINKS*/
 
a {
    color: #b30000;
    text-decoration: none;
}
 
a:hover {
    text-decoration: underline;
}
 
 
/*IMAGENS*/
 
img {
    width: 300px;
    height: auto;
    gap: 10px;
}
 
 
/*ARTIGOS / CARDS*/
 
article {
    background: #ecf0f1;
    padding: 15px;
    transition: transform 0.3s;
}
 
article:hover {
    transform: scale(1.05);
}
 
.card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
 
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.2);
}
 
 
/*TABELA RECURSOS*/
 
table {
    width: 90%;
    margin: 20px auto;
    border-collapse: collapse;
    background-color: #ffffff;
}
 
th {
    background-color: #b30000;
    color: #ffffff;
    padding: 10px;
    border: 1px solid #4a2c1a;
}
 
td {
    padding: 10px;
    border: 1px solid #4a2c1a;
    text-align: center;
}
 
 
/*TABELA QUEM SOMOS*/
 
.tabela-quem_somos {
    width: 60%;
    margin: 40px auto;
    border-collapse: collapse;
    background-color: white;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}
 
.tabela-quem_somos th {
    background-color: #8B0000;
    color: white;
    padding: 12px;
    font-size: 18px;
}
 
.tabela-quem_somos td {
    padding: 12px;
    border: 1px solid #a67c52;
    text-align: center;
}
 
.tabela-quem_somos tr:nth-child(even) {
    background-color: #f5f5f5;
}
 
.tabela-quem_somos tr:hover {
    background-color: #a67c52;
    color: white;
    transition: 0.3s;
}
 
 
/*FORMULÁRIO*/
 
form {
    max-width: 600px;
    margin: 40px auto;
    background-color: #ffffff;
    padding: 30px;
    border-radius: 8px;
    border-top: 6px solid #8B0000;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    font-family: "Times New Roman", serif;
}
 
form h2 {
    font-family: 'League Spartan', sans-serif;
    color: #8B0000;
    margin-bottom: 10px;
}
 
form p {
    color: #5a3e2b;
    margin-bottom: 20px;
}
 
form label {
    font-weight: bold;
    color: #5a3e2b;
}
 
form input[type="text"],
form input[type="email"],
form select,
form textarea {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #c4a484;
    border-radius: 4px;
    font-family: "Times New Roman", serif;
}
 
form textarea {
    resize: vertical;
}
 
form input[type="checkbox"] {
    margin-right: 8px;
}
 
form input[type="submit"] {
    background-color: #8B0000;
    color: #ffffff;
    border: none;
    padding: 12px 20px;
    font-size: 16px;
    border-radius: 4px;
    cursor: pointer;
    font-family: 'League Spartan', sans-serif;
    transition: all 0.3s ease;
}
 
form input[type="submit"]:hover {
    background-color: #5a0000;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}
 
 
/*CONTACTOS*/
 
.contactos-container {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    margin: 50px auto;
    width: 80%;
}
 
.card-contacto {
    background-color: white;
    border-left: 8px solid #8B0000;
    padding: 25px;
    width: 220px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    transition: transform 0.3s ease;
}
 
.card-contacto h3 {
    color: #8B0000;
    margin-bottom: 10px;
}
 
.card-contacto p {
    color: #5a3e2b;
    font-family: "Times New Roman", serif;
}
 
.card-contacto:hover {
    transform: translateY(-8px);
}
 
 
/*RODAPÉ*/
 
#rodape {
    background-color: #4a2c1a;
    color: #ffffff;
    text-align: center;
    padding: 10px;
    margin-top: 40px;
    display: inline-block;
    min-width: 100%;
}
 
 
/*ANIMAÇÕES*/
 
@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
 
 
.botao, button {
    transition: all 0.3s ease;
}
 
.botao:hover, button:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

th a, 
th a:link, 
th a:visited, 
th a:active {
    color: #ffffff !important;
    text-decoration: none !important;
}

th a:hover {
    text-decoration: underline !important;
    color: #ffffff !important;
}

.container form[action*="ListarContatosServlet"],
#conteudo form[action*="ListarContatosServlet"] {
    border-top: none !important;
    box-shadow: none !important;
    margin: 10px auto;
    padding: 10px 0;
    max-width: 100%;
}