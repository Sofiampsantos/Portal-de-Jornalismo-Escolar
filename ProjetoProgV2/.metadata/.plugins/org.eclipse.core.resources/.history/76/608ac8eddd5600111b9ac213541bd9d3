@charset "UTF-8";
@import url('https://fonts.googleapis.com/css2?family=League+Spacer:wght@400;600;700&display=swap');


/* ===== ESTILO GERAL ===== */
body {
    margin: 0;
    padding: 0;
    font-family: "Times New Roman", Times, serif;
    color: #4a2c1a;
}

.container {
    max-width: 1100px;
    margin: 40px auto;
    background-color: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 20px rgba(0,0,0,0.2);
}

/* ===== CABEÇALHO ===== */
#topo {
    background-color: #b30000;
    color: #ffffff;
    padding: 20px;
    text-align: center;
}

#topo h1 { margin: 0; }

/* ===== NAVEGAÇÃO ===== */
nav {
    display: flex;
    justify-content: center;
    background-color: #8B0000;
    padding: 15px 0;
}

nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

nav ul li {
    display: inline;
    margin: 0 15px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

/* ===== CONTEÚDO E TÍTULOS ===== */
#conteudo { padding: 30px; animation: aparecer 2s ease-in; }

h2 {
    color: #b30000;
    padding-bottom: 5px;
    font-family: 'League Spartan', Arial, sans-serif;
}

p { line-height: 1.6; }

/* ===== IMAGENS ===== */
/* Imagem do logo com classe específica */
.logo { width: 184px; height: 211px; }

/* Imagens do conteúdo */
section img {
    width: 240px; 
    height: auto;
    margin: 5px;
}

/* ===== TABELA ===== */
table {
    width: 90%;
    margin: 20px auto;
    border-collapse: collapse;
}

th, td {
    padding: 10px;
    border: 1px solid #4a2c1a;
    text-align: center;
}

th { background-color: #b30000; color: #ffffff; }

/* CORREÇÃO MÁXIMA: Força os links de ordenação a ficarem brancos em qualquer estado */
th a, 
th a:link, 
th a:visited, 
th a:active {
    color: #ffffff !important;
    text-decoration: none !important;
}

th a:hover {
    text-decoration: underline !important;
    color: #ffffff !important;
}

/* ===== FORMULÁRIO ===== */
form {
    max-width: 600px;
    margin: 40px auto;
    padding: 30px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

form input, form textarea, form select {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #c4a484;
}

/* ===== RODAPÉ ===== */
#rodape {
    background-color: #4a2c1a;
    color: #ffffff;
    text-align: center;
    padding: 10px;
    margin-top: 40px;
}

/* ===== ANIMAÇÕES ===== */
@keyframes aparecer {
    from { opacity: 0; }
    to { opacity: 1; }
}

.card { transition: transform 0.3s ease; }
.card:hover { transform: translateY(-5px); }

form, 
form input[type="text"], 
div:has(> form) {
    border-top: none !important;
}

#conteudo hr, 
table + hr,
table + div hr {
    display: none !important;
    border: none !important;
    height: 0 !important;
}