<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Portal de Jornalismo Escolar - ESMM - Formulário de Contacto</title>
<link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/styles/estilo.css">
</head>
<body style="background-image: url('${pageContext.request.contextPath}/img/jornmulheres.jpg'); background-size: cover; background-repeat: no-repeat; background-attachment: fixed; background-position: center;">
 
 <div class="container">
 		
    <header id="topo">
        <img alt="Fotografia do Portal de Jornalismo Escolar"
             src="${pageContext.request.contextPath}/img/logoP.jpg" style="width: 184px; height: 211px;">
        <h1>Portal de Jornalismo da Escola Secundária de Mem Martins</h1>
    </header>
     
    <nav id="navegacao">
        <ul>
            <li><a href="index.html">Início</a></li>
            <li><a href="quem_somos.html">Quem Somos</a></li>
            <li><a href="projetos.html">Projetos</a></li>
            <li><a href="recursos.html">Recursos</a></li>
            <li><a href="contactos.html">Contactos</a></li>
            <li><a href="contato.jsp">Formulário de Contacto</a></li>
        </ul>
    </nav>
 
    <section id="conteudo">
 
        <form name="formulario" action="ContatoServlet" method="post" onsubmit="return validarFormulario()">
     
            <h2>Contacto com o Portal Escolar</h2>
            <p>Utiliza este formulário para enviar sugestões, notícias ou dúvidas.</p>
         
            <label>Nome:</label><br>
            <input type="text" name="nome" placeholder="Digite o seu nome" required><br><br>
         
            <label for="email">Email:</label>
			<input type="email" id="email" name="email" placeholder="exemplo@dominio.com" required>
         
            <label>Assunto:</label><br>
            <select name="assunto" required>
                <option value="">-- Selecione um assunto --</option>
                <option value="Sugestão de notícia">Sugestão de notícia</option>
                <option value="Divulgação de evento">Divulgação de evento</option>
                <option value="Correção de informação">Correção de informação</option>
                <option value="Outro">Outro</option>
            </select><br><br>
         
            <label>Mensagem:</label><br>
            <textarea name="mensagem" rows="5" placeholder="Escreva a sua mensagem" required></textarea><br><br>
         
            <input type="checkbox" name="aceitar" required>
            <label>Confirmo que a informação enviada é verdadeira</label><br><br>
         
            <input type="submit" value="Enviar mensagem">
         
        </form>
        
        <br>
        <a href="ListarContatosServlet" style="font-weight: bold;">Ver Mensagens Recebidas (Lista)</a>
        
    </section>
 </div>
    
 <footer id="rodape">
    <p>&copy; 2026 Portal de Jornalismo Escolar ESMM | Todos os direitos reservados.</p> 
 </footer>      
    
 <script src="${pageContext.request.contextPath}/scripts/script.js"></script> 
</body>
</html>