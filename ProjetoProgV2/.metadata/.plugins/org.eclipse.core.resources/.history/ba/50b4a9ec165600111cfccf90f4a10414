package br.com.formulario; 

import java.io.IOException; 
import java.sql.*;
import java.util.ArrayList;
import java.util.List; 

import jakarta.servlet.ServletException; 
import jakarta.servlet.annotation.WebServlet; 
import jakarta.servlet.http.*; 

@WebServlet("/ListarContatosServlet") 
public class ListarContatosServlet extends HttpServlet { 

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	protected void doGet(HttpServletRequest request, HttpServletResponse response) 
			throws ServletException, IOException { 

		List<String[]> contatos = new ArrayList<>(); 
		String ordenarPor = request.getParameter("ordem");
		
		if(ordenarPor == null ||
				(!ordenarPor.equals("nome")&&
						!ordenarPor.equals("email")&&
						!ordenarPor.equals("assunto"))) {
			ordenarPor="nome"; 
			
			
		}
					
		//rver código seguinte na pr´xima aula - atividade 5	

		try { 
			Class.forName("com.mysql.cj.jdbc.Driver"); /*Isso ta para que base dados xampp ou o mariadb no quadro estava outra
			cena, ent tenho q alterar né? Vamos ver pera, oki*/

 

			Connection conn = DriverManager.getConnection( 
					"jdbc:mysql://localhost:3306/clube_db", 
					"root", 
					"" 
					); 

 

			Statement stmt = conn.createStatement(); 
			ResultSet rs = stmt.executeQuery("SELECT * FROM contatos ORDER BY" + ordenarPor + "ASC"); 

			while (rs.next()) { 
				contatos.add(new String[]{
					rs.getString("id"),
					rs.getString("nome"),
					rs.getString("email"),
					rs.getString("assunto"),
					rs.getString("mensagem"),
				});
				
			}
			
			conn.close();
			
		} catch (Exception e) {
			e.printStackTrace();
		}
	
		request.setAttribute("contatos", contatos);
		request.getRequestDispatcher("listar.jsp").forward (request, response);

} 

} 
