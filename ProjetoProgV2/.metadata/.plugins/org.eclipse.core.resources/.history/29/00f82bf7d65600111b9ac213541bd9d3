function confirmarPortal() {
	var resposta = confirm("Tens uma notícia ou sugestão?");
	var paragrafo = document.getElementById("resposta");
	
	if (paragrafo) {
		if(resposta) {
			paragrafo.innerHTML = "Obrigado por contribuir para o Portal Escolar.";
		} else {
			paragrafo.innerHTML = "Talvez noutra altura!";
		}
	} else {
		alert("Erro: element <p id= 'resposta'> não encontrado");
	}
}
 
