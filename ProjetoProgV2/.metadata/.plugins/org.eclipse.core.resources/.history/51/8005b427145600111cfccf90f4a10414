@import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;600;700&display=swap');
@charset="UTF-8";
 
/* ===== ESTILO GERAL ===== */
body {
    margin: 0;
    padding: 0;
    font-family: "Times New Roman", Times, serif;
    background-color: #ffffff;
    color: #4a2c1a;
}
 
/* ===== CONTAINER ===== */
#container {
    width: 100%;
    margin: 0 auto;
}
 
/* ===== CABEÇALHO ===== */
#topo {
    background-color: #b30000; /* vermelho */
    color: #ffffff; /* branco */
    padding: 20px;
    text-align: center;
}
 
#topo h1 {
    margin: 0;
}
 
#topo p {
    margin-top: 5px;
}
 
/* ===== CONTEÚDO ===== */
#conteudo {
    padding: 30px;
}
 
/* ===== TÍTULOS ===== */
h2 {
    color: #b30000; /* vermelho */
    border-bottom: 2px solid #4a2c1a; /* castanho */
    padding-bottom: 5px;
    font-family: 'League Spartan', Arial, sans-serif;
}
 
/* ===== PARÁGRAFOS ===== */
p {
    line-height: 1.6;
}
 
/* ===== TABELA (RECURSOS) ===== */
table {
    width: 90%;
    margin: 20px auto;
    border-collapse: collapse;
    background-color: #ffffff;
}
 
th {
    background-color: #b30000; /* vermelho */
    color: #ffffff; /* branco */
    padding: 10px;
    border: 1px solid #4a2c1a; /* castanho */
}
 
td {
    padding: 10px;
    border: 1px solid #4a2c1a; /* castanho */
    text-align: center;
}
 
/* ===== LINKS ===== */
a {
    color: #b30000;
    text-decoration: none;
}
 
a:hover {
    text-decoration: underline;
}
 
/* ===== RODAPÉ ===== */
#rodape {
    background-color: #4a2c1a; /* castanho */
    color: #ffffff;
    text-align: center;
    padding: 10px;
    margin-top: 40px;
    display: inline-block;
    min-width: 100%;
}
 
img {
  width: 300px;
  height: auto;
  gap: 10px; /*espaço entre as imagens*/
  
}
