/* ===== FORMULÁRIO ===== */
 
form {
    max-width: 600px;
    margin: 40px auto;
    background-color: #ffffff;
    padding: 30px;
    border-radius: 8px;
    border-top: 6px solid #8B0000; /* vermelho escuro */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    font-family: "Times New Roman", serif;
}
 
/* Título do formulário */
form h2 {
    font-family: 'League Spartan', sans-serif;
    color: #8B0000;
    margin-bottom: 10px;
}
 
/* Texto introdutório */
form p {
    color: #5a3e2b; /* castanho */
    margin-bottom: 20px;
}
 
/* Labels */
form label {
    font-weight: bold;
    color: #5a3e2b;
}
 
/* Campos de input, select e textarea */
form input[type="text"],
form input[type="email"],
form select,
form textarea {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #c4a484; /* castanho claro */
    border-radius: 4px;
    font-family: "Times New Roman", serif;
}
 
/* Caixa de texto */
form textarea {
    resize: vertical;
}
 
/* Checkbox */
form input[type="checkbox"] {
    margin-right: 8px;
}
 
/* Botão */
form input[type="submit"] {
    background-color: #8B0000;
    color: #ffffff;
    border: none;
    padding: 12px 20px;
    font-size: 16px;
    border-radius: 4px;
    cursor: pointer;
    font-family: 'League Spartan', sans-serif;
}
 
/* Efeito hover no botão */
form input[type="submit"]:hover {
    background-color: #5a0000;
}

nav {
	display: flex;
	justify-content: space-around;
	background-color: #b30000;
}

nav a {
	color: white;
	text-decoration: none;
	padding: 10px;
}

article{
	background: #ecf0f1;
	padding: 15px;
	transition: transform 0.3s;
}

article:hover{
	transform: scale(1.05);
}

@keyframes aparecer{
	from { opacity: 0; }
	to { opacity: 1; }
}


section {
	animation: aparecer 2s ease-in;
}

.card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.2);
}


nav {
    background-color: #8B0000;
    padding: 15px 0;
}

nav ul li{
    display: inline;
}





.container {
    max-width: 1100px;     /* largura máxima */
    margin: 40px auto;     /* centra na página */
    background-color: white;
    padding: 30px;
    border-radius: 10px;   /* cantos arredondados */
    box-shadow: 0 0 20px rgba(0,0,0,0.2); /* sombra elegante */
}

